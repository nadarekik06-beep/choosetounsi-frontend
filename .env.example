# Copy to .env.local (dev) or set in your hosting provider (production).
# NEXT_PUBLIC_* values are baked into the bundle at `npm run build`: rebuild after changing them.
# No secret belongs here: the AI (Groq) key lives in the Laravel API's .env only.

# Laravel API origin, WITHOUT /api (lib/constants.ts adds it). Production: https://api.choosetounsi.tn
# Unset → http://localhost:8000. A trailing /api is tolerated.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site, no trailing slash. Used for shared store links, QR codes,
# canonical and Open Graph tags. Required in production (e.g. https://choosetounsi.tn).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Facebook app id. Enables the Messenger share button on desktop
# (without it, Messenger sharing is only offered on phones with the app).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Realtime notifications (Pusher). Not used at launch: leave empty, the app falls back to polling.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
